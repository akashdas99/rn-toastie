{
  "name": "rn-toastie",
  "version": "0.2.1",
  "description": "Swipeable, stackable toast notifications for React Native and Expo. Promise and custom toasts, 8 positions, themes, configurable animations, built on Reanimated.",
  "license": "MIT",
  "author": "Akash Das (https://github.com/akashdas99)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashdas99/rn-toastie.git"
  },
  "homepage": "https://github.com/akashdas99/rn-toastie#readme",
  "bugs": {
    "url": "https://github.com/akashdas99/rn-toastie/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "toast",
    "toaster",
    "toast-notifications",
    "snackbar",
    "notifications",
    "stacked",
    "swipe",
    "reanimated",
    "gesture-handler"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "jest",
    "build": "bob build",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepare": "bob build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-gesture-handler": ">=2.14",
    "react-native-reanimated": ">=3.6",
    "react-native-safe-area-context": ">=4",
    "react-native-worklets": ">=0.5"
  },
  "peerDependenciesMeta": {
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-worklets": "^0.13.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
